-- SipTrack SQLDelight schema

CREATE TABLE IF NOT EXISTS UserProfileEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    weightKg REAL NOT NULL DEFAULT 70.0,
    gender TEXT NOT NULL DEFAULT 'OTHER',
    age INTEGER NOT NULL DEFAULT 30,
    metabolicRate REAL NOT NULL DEFAULT 0.015,
    personalLimitBac REAL NOT NULL DEFAULT 0.06,
    driveLimitBac REAL NOT NULL DEFAULT 0.08,
    emergencyContactName TEXT NOT NULL DEFAULT '',
    emergencyContactPhone TEXT NOT NULL DEFAULT '',
    preferMetric INTEGER NOT NULL DEFAULT 0,
    enableNotifications INTEGER NOT NULL DEFAULT 1,
    enableHealthKit INTEGER NOT NULL DEFAULT 0,
    appMode TEXT NOT NULL DEFAULT 'NORMAL',
    onboardingComplete INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS DrinkSessionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    startTime INTEGER NOT NULL,
    endTime INTEGER,
    mode TEXT NOT NULL DEFAULT 'NORMAL',
    notes TEXT
);

CREATE TABLE IF NOT EXISTS DrinkEntity (
    id TEXT NOT NULL PRIMARY KEY,
    sessionId TEXT NOT NULL,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    abvPercent REAL NOT NULL,
    volumeOz REAL NOT NULL,
    loggedAt INTEGER NOT NULL,
    productId TEXT,
    notes TEXT,
    isMicroDose INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (sessionId) REFERENCES DrinkSessionEntity(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_drink_session ON DrinkEntity(sessionId);
CREATE INDEX IF NOT EXISTS idx_session_start ON DrinkSessionEntity(startTime DESC);

-- UserProfile queries
insertOrReplaceProfile:
INSERT OR REPLACE INTO UserProfileEntity VALUES
(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectProfile:
SELECT * FROM UserProfileEntity WHERE id = 1;

-- Session queries
insertSession:
INSERT INTO DrinkSessionEntity (id, startTime, endTime, mode, notes)
VALUES (?, ?, ?, ?, ?);

updateSessionEndTime:
UPDATE DrinkSessionEntity SET endTime = ? WHERE id = ?;

selectActiveSession:
SELECT * FROM DrinkSessionEntity WHERE endTime IS NULL ORDER BY startTime DESC LIMIT 1;

selectAllSessions:
SELECT * FROM DrinkSessionEntity ORDER BY startTime DESC;

selectSessionById:
SELECT * FROM DrinkSessionEntity WHERE id = ?;

deleteSession:
DELETE FROM DrinkSessionEntity WHERE id = ?;

-- Drink queries
insertDrink:
INSERT INTO DrinkEntity (id, sessionId, name, category, abvPercent, volumeOz, loggedAt, productId, notes, isMicroDose)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectDrinksForSession:
SELECT * FROM DrinkEntity WHERE sessionId = ? ORDER BY loggedAt ASC;

deleteDrink:
DELETE FROM DrinkEntity WHERE id = ?;

deleteAllDrinksForSession:
DELETE FROM DrinkEntity WHERE sessionId = ?;

-- Stats queries
countDrinksThisWeek:
SELECT COUNT(*) FROM DrinkEntity WHERE loggedAt >= ?;

deleteAll:
DELETE FROM DrinkEntity;
DELETE FROM DrinkSessionEntity;
