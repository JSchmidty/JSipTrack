<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SipTrack.ViewModels"
             x:Class="SipTrack.Views.LogDrinkPage"
             x:DataType="vm:LogDrinkViewModel"
             Title="Log a Drink"
             BackgroundColor="#0D0D0D">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="Quick Add" FontSize="18" FontAttributes="Bold" TextColor="White"/>
            <CollectionView ItemsSource="{Binding QuickDrinks}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickDrink">
                        <Frame BackgroundColor="#1A1A2E" CornerRadius="16" Padding="10" HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LogDrinkViewModel}}, Path=LogQuickDrinkCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="{Binding Icon}" FontSize="32" HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold"
                                       TextColor="White" HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding AbvPercent, StringFormat='{0:F0}% ABV'}"
                                       FontSize="11" TextColor="#AAAAAA" HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding VolumeOz, StringFormat='{0:F1} oz'}"
                                       FontSize="11" TextColor="#AAAAAA" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Custom Drink Form -->
            <Frame BackgroundColor="#1A1A2E" CornerRadius="16" Padding="16" IsVisible="{Binding ShowCustomForm}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Custom Drink" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                    <Entry Text="{Binding CustomName}" Placeholder="Drink name" PlaceholderColor="#AAAAAA"
                           TextColor="White" BackgroundColor="#0D0D0D"/>
                    <Label Text="{Binding CustomAbv, StringFormat='ABV: {0:F1}%'}" TextColor="White"/>
                    <Slider Value="{Binding CustomAbv}" Minimum="0" Maximum="100"
                            MinimumTrackColor="#4CAF50" MaximumTrackColor="#333333"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding CustomVolume, StringFormat='{0:F1}'}"
                               Keyboard="Numeric" TextColor="White" BackgroundColor="#0D0D0D"
                               Placeholder="Volume" PlaceholderColor="#AAAAAA"/>
                        <Button Grid.Column="1" Text="{Binding VolumeUnit}"
                                BackgroundColor="#333333" TextColor="White" CornerRadius="8"
                                WidthRequest="60"/>
                    </Grid>
                    <Button Text="Log Custom Drink" BackgroundColor="#4CAF50" TextColor="White"
                            CornerRadius="12" Command="{Binding LogCustomDrinkCommand}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Search -->
            <Label Text="Search Beverage Database" FontSize="18" FontAttributes="Bold" TextColor="White"/>
            <SearchBar Text="{Binding SearchQuery}"
                       Placeholder="Search beverages..."
                       PlaceholderColor="#AAAAAA"
                       BackgroundColor="#1A1A2E"
                       TextColor="White"
                       SearchCommand="{Binding SearchBeveragesCommand}"/>
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#4CAF50" IsVisible="{Binding IsBusy}"/>

            <CollectionView ItemsSource="{Binding SearchResults}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#1A1A2E" CornerRadius="12" Padding="14" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="{Binding Brand}" FontSize="12" TextColor="#AAAAAA"/>
                                    <Label Text="{Binding Category}" FontSize="11" TextColor="#888888"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding Abv, StringFormat='{0:F1}%'}"
                                       FontSize="18" FontAttributes="Bold" TextColor="#4CAF50"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
