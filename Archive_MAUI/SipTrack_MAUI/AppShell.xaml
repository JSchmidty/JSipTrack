<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SipTrack.Views"
       x:Class="SipTrack.AppShell"
       Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="#0D0D0D"
       Shell.TabBarForegroundColor="#4CAF50"
       Shell.TabBarUnselectedColor="#666666">

    <TabBar>
        <ShellContent Title="Dashboard" Route="Dashboard" Icon="home.png">
            <ShellContent.ContentTemplate>
                <DataTemplate>
                    <views:DashboardPage/>
                </DataTemplate>
            </ShellContent.ContentTemplate>
        </ShellContent>

        <ShellContent Title="Log" Route="LogDrink" Icon="plus.png">
            <ShellContent.ContentTemplate>
                <DataTemplate>
                    <views:LogDrinkPage/>
                </DataTemplate>
            </ShellContent.ContentTemplate>
        </ShellContent>

        <ShellContent Title="History" Route="History" Icon="chart.png">
            <ShellContent.ContentTemplate>
                <DataTemplate>
                    <views:HistoryPage/>
                </DataTemplate>
            </ShellContent.ContentTemplate>
        </ShellContent>

        <ShellContent Title="Settings" Route="Settings" Icon="gear.png">
            <ShellContent.ContentTemplate>
                <DataTemplate>
                    <views:SettingsPage/>
                </DataTemplate>
            </ShellContent.ContentTemplate>
        </ShellContent>
    </TabBar>

    <!-- Modal / Detail routes -->
    <Shell.RouteFactory>
        <x:Null/>
    </Shell.RouteFactory>
</Shell>
