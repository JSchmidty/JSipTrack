<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-ios;net8.0-android</TargetFrameworks>
    <RootNamespace>SipTrack</RootNamespace>
    <AssemblyName>SipTrack</AssemblyName>
    <ApplicationId>ai.siptech.siptrack</ApplicationId>
    <ApplicationIdGuid>4D2E1F8A-3C6B-4A7D-9E5F-0A1B2C3D4E5F</ApplicationIdGuid>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <!-- iOS-specific -->
    <MtouchArch Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">ARM64</MtouchArch>
    <CodesignKey Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">iPhone Developer</CodesignKey>
    <!-- Android-specific -->
    <AndroidPackageFormat Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- App display name & icon -->
  <PropertyGroup>
    <ApplicationTitle>SipTrack</ApplicationTitle>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#4CAF50"/>
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0D0D0D" BaseSize="128,128"/>
  </PropertyGroup>

  <!-- Resources -->
  <ItemGroup>
    <MauiImage Include="Resources/Images/*"/>
    <MauiFont Include="Resources/Fonts/*"/>
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>

  <!-- AppStyles -->
  <ItemGroup>
    <MauiXaml Include="Resources/Styles/AppStyles.xaml" Generator="MSBuild:Compile"/>
  </ItemGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="9.0.1"/>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2"/>
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172"/>
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.8"/>
    <PackageReference Include="Plugin.LocalNotification" Version="11.1.2"/>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Maui" Version="2.0.0-rc4"/>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.70"/>
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.70"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0"/>
  </ItemGroup>

</Project>
