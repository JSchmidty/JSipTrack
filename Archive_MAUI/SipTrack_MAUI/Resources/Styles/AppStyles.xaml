<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:SipTrack.Converters">

    <!-- Converters -->
    <conv:BACToColorConverter x:Key="BACToColorConverter"/>
    <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <conv:IsNotNullConverter x:Key="IsNotNullConverter"/>
    <conv:StringEqualConverter x:Key="StringEqualConverter"/>

    <!-- Colors -->
    <Color x:Key="AppBackground">#0D0D0D</Color>
    <Color x:Key="CardBackground">#1A1A2E</Color>
    <Color x:Key="AccentGreen">#4CAF50</Color>
    <Color x:Key="AccentAmber">#FFC107</Color>
    <Color x:Key="AccentRed">#F44336</Color>
    <Color x:Key="AccentBlue">#2196F3</Color>
    <Color x:Key="TextPrimary">White</Color>
    <Color x:Key="TextSecondary">#AAAAAA</Color>

    <!-- Entry style -->
    <Style TargetType="Entry" ApplyToDerivedTypes="True">
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="BackgroundColor" Value="#111111"/>
        <Setter Property="PlaceholderColor" Value="#666666"/>
    </Style>

    <!-- Button styles -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#4CAF50"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HeightRequest" Value="48"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#F44336"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="HeightRequest" Value="48"/>
    </Style>

    <!-- Card Frame -->
    <Style x:Key="CardFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="#1A1A2E"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HasShadow" Value="False"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Section Header -->
    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="White"/>
    </Style>
</ResourceDictionary>
