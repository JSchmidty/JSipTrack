<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>SipTrack</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.siptech.siptrack</string>
    <!-- USER_TODO: Replace with your actual Apple Developer Team Bundle ID -->
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>SipTrack</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSHealthShareUsageDescription</key>
    <string>SipTrack reads your health data to provide personalized BAC estimates and correlate with sleep and fitness data.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>SipTrack writes alcohol consumption data to Apple Health to help you track your wellness over time.</string>
    <key>NSContactsUsageDescription</key>
    <string>SipTrack uses your contacts to set up emergency contacts for safety alerts.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>SipTrack can optionally attach your location to sessions for tracking where you drink.</string>
    <key>NSCameraUsageDescription</key>
    <string>SipTrack uses the camera to scan barcodes and find drinks in the beverage database.</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Automatic</string>
</dict>
